{
  "name": "crunchpad",
  "productName": "crunchpad",
  "version": "0.1.0",
  "description": "A ProseMirror-based document editor built for writing inline math.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "assets": "node scripts/copy-mathlive-assets.mjs",
    "predev": "npm run assets",
    "dev": "vite",
    "prebuild": "npm run assets",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "desktop": "npm run build && electron .",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "app.crunchpad.editor",
    "productName": "crunchpad",
    "icon": "electron/icon.png",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "fileAssociations": [
      {
        "ext": "crunchpad",
        "name": "crunchpad document",
        "role": "Editor",
        "mimeType": "application/x-crunchpad"
      },
      {
        "ext": "mathdoc",
        "name": "crunchpad document (legacy)",
        "role": "Editor",
        "mimeType": "application/x-mathmirror"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "crunchpad-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "crunchpad-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "artifactName": "crunchpad-linux.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "crunchpad-Setup.${ext}"
    }
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "mathlive": "^0.111.4",
    "mathml2omml": "^0.5.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.6.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.13",
    "prosemirror-schema-basic": "^1.2.5",
    "prosemirror-schema-list": "^1.6.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.9"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
